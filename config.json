{
  "title": "Small cap tracker",
  "repo": "richardch2/Trader",
  "primary": "IWM",
  "benchmark": "SPY",
  "defaultRange": "3M",
  "api": {
    "provider": "alphavantage",
    "dailyBudget": 25,
    "minIntervalSeconds": 13
  },
  "tickers": [
    {
      "symbol": "IWM",
      "name": "iShares Russell 2000",
      "group": "Index"
    },
    {
      "symbol": "IJR",
      "name": "iShares Core S&P Small-Cap",
      "group": "Index"
    },
    {
      "symbol": "VB",
      "name": "Vanguard Small-Cap",
      "group": "Index"
    },
    {
      "symbol": "VTWO",
      "name": "Vanguard Russell 2000",
      "group": "Index"
    },
    {
      "symbol": "SCHA",
      "name": "Schwab U.S. Small-Cap",
      "group": "Index"
    },
    {
      "symbol": "IWN",
      "name": "iShares Russell 2000 Value",
      "group": "Style"
    },
    {
      "symbol": "IWO",
      "name": "iShares Russell 2000 Growth",
      "group": "Style"
    },
    {
      "symbol": "SPY",
      "name": "SPDR S&P 500 (large-cap)",
      "group": "Benchmark"
    }
  ],
  "watchlist": [],
  "fetchers": [
    {
      "name": "prices",
      "enabled": true
    }
  ],
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "cards": [
        {
          "type": "headline"
        },
        {
          "type": "performance",
          "width": "full",
          "title": "Performance"
        },
        {
          "type": "spread",
          "width": "half",
          "title": "Small vs large",
          "a": "IWM",
          "b": "SPY"
        },
        {
          "type": "pair",
          "width": "half",
          "title": "Value vs growth",
          "note": "Russell 2000 value (IWN) against growth (IWO).",
          "series": [
            {
              "symbol": "IWN",
              "label": "Value"
            },
            {
              "symbol": "IWO",
              "label": "Growth"
            }
          ]
        },
        {
          "type": "table",
          "width": "full",
          "title": "All tickers"
        }
      ]
    },
    {
      "id": "watchlist",
      "title": "Watchlist",
      "heading": "Watchlist",
      "cards": [
        {
          "type": "table",
          "width": "full",
          "title": "Watchlist",
          "list": "watchlist",
          "editable": true,
          "columns": [
            {
              "key": "d1",
              "label": "1D",
              "days": 1
            },
            {
              "key": "w1",
              "label": "1W",
              "days": 5
            },
            {
              "key": "m1",
              "label": "1M",
              "days": 21
            }
          ]
        },
        {
          "type": "movers",
          "width": "half",
          "title": "Today's biggest moves",
          "list": "watchlist",
          "days": 1
        },
        {
          "type": "movers",
          "width": "half",
          "title": "This month",
          "list": "watchlist",
          "days": 21
        },
        {
          "type": "performance",
          "width": "full",
          "title": "Watchlist performance",
          "list": "watchlist",
          "highlight": []
        }
      ]
    },
    {
      "id": "ticker",
      "title": "Ticker",
      "hidden": true,
      "cards": [
        {
          "type": "ticker",
          "width": "full"
        },
        {
          "type": "performance",
          "width": "full",
          "title": "Against the market",
          "symbols": [
            "$route",
            "$primary",
            "$benchmark"
          ],
          "highlight": [
            "$route",
            "$benchmark"
          ]
        }
      ]
    }
  ]
}
